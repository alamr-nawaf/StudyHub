    USERS ||--o{ COURSES : "creates"
    USERS ||--o{ NOTES : "writes"
    USERS ||--o{ TASKS : "owns"
    USERS ||--o{ AI_USAGE_LOGS : "generates"
    USERS ||--o{ REFRESH_TOKENS : "secures session"
    COURSES ||--o{ TASKS : "groups"
    COURSES ||--o{ NOTES : "contextualizes"
    NOTES ||--o{ TASKS : "source of"

    USERS {
        uniqueidentifier Id PK
        string FullName
        string Email
        string PasswordHash
        int MonthlyTokenQuota
        int TokensUsedThisMonth
        datetime LastTokenResetDate
        boolean IsActive
        datetime CreatedAt
        datetime UpdatedAt
    }

    REFRESH_TOKENS {
        uniqueidentifier Id PK
        uniqueidentifier UserId FK
        string Token
        datetime ExpiresAt
        datetime RevokedAt "Nullable"
        datetime CreatedAt
    }

    COURSES {
        uniqueidentifier Id PK
        uniqueidentifier UserId FK
        string Title
        string Description "Nullable"
        boolean IsDeleted
        datetime CreatedAt
        datetime UpdatedAt
    }

    NOTES {
        uniqueidentifier Id PK
        uniqueidentifier UserId FK
        uniqueidentifier CourseId FK "Nullable"
        string Title
        string Content
        boolean IsDeleted
        datetime CreatedAt
        datetime UpdatedAt
    }

    TASKS {
        uniqueidentifier Id PK
        uniqueidentifier UserId FK
        uniqueidentifier CourseId FK "Nullable"
        uniqueidentifier SourceNoteId FK "Nullable"
        string Title
        string Description "Nullable"
        int Status
        int Priority
        datetime DueDate "Nullable"
        boolean IsDeleted
        datetime CreatedAt
        datetime UpdatedAt
    }

    AI_USAGE_LOGS {
        uniqueidentifier Id PK
        uniqueidentifier UserId FK
        string OperationType
        int TokensConsumed
        datetime OperationDate
    }