%% StudyHub — Entity Relationship Diagram v2.0
%% Five tables. Notes and Tasks were merged into ITEMS in M5 (see Requirements.md ADR-08).
%% ITEMS is a Table-Per-Hierarchy table: Kind = 0 is a Note, Kind = 1 is a Task.

erDiagram
    USERS ||--o{ COURSES : "owns"
    USERS ||--o{ ITEMS : "owns"
    USERS ||--o{ REFRESH_TOKENS : "holds sessions"
    USERS ||--o{ AI_USAGE_LOGS : "generates"
    COURSES ||--o{ ITEMS : "groups"
    ITEMS ||--o{ ITEMS : "contains"

    USERS {
        uuid Id PK
        string FullName "150"
        string Email UK "150, normalized lowercase"
        string PasswordHash "BCrypt enhanced"
        int MonthlyTokenQuota
        int TokensUsedThisMonth
        datetime LastTokenResetDate
        bool IsActive
        datetime CreatedAt
        datetime UpdatedAt "nullable"
    }

    COURSES {
        uuid Id PK
        uuid UserId FK "restrict"
        string Title "200, CK non-blank"
        string Description "nullable"
        bool IsDeleted "soft delete"
        datetime CreatedAt
        datetime UpdatedAt "nullable"
    }

    ITEMS {
        uuid Id PK
        uuid UserId FK "restrict"
        uuid CourseId FK "nullable, inherited from parent"
        uuid ParentItemId FK "nullable, self-reference"
        int Depth "0-4, CK"
        string Title "250, CK non-blank"
        string Content "nullable, unbounded"
        bool IsDeleted "soft delete, cascades down"
        int Kind "0 Note, 1 Task"
        int Status "nullable, tasks only"
        int Priority "nullable, tasks only"
        datetime DueDate "nullable, tasks only"
        datetime CreatedAt
        datetime UpdatedAt "nullable"
    }

    REFRESH_TOKENS {
        uuid Id PK
        uuid UserId FK "cascade"
        string TokenHash UK "64, SHA-256 hex"
        datetime ExpiresAt
        datetime RevokedAt "nullable"
        uuid ReplacedByTokenId "nullable, rotation chain"
        datetime CreatedAt
        datetime UpdatedAt "nullable"
    }

    AI_USAGE_LOGS {
        uuid Id PK
        uuid UserId FK "restrict"
        string OperationType "50"
        int TokensConsumed
        datetime CreatedAt "no UpdatedAt, write-once"
    }
