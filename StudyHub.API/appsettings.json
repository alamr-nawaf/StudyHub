{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "StudyHub",
    "Audience": "StudyHub.API",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Ai": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
    "Model": "",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 2048,
    "CharsPerToken": 4,
    "ResponseReserveTokens": 400,
    "MaxSuggestions": 5,
    "ThinkingBudget": null,
    "ThinkingLevel": "",
    "FakeFailure": false
  },
  "UserQuota": {
    "DefaultMonthlyTokens": 100000
  }
}
